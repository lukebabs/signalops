[Unit]
Description=SignalOps MarketOps governed task retry worker
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@WORKDIR@
ExecStart=@WORKDIR@/scripts/marketops_scheduled_job.sh marketops-task-retry "Weekdays every 15 minutes, 16:45-20:00" America/New_York @WORKDIR@/scripts/marketops_tactical_retry.sh
TimeoutStartSec=30m
Nice=10
