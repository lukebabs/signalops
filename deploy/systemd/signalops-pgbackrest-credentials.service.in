[Unit]
Description=Refresh short-lived AWS credentials for SignalOps PostgreSQL backups
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/signalops/pgbackrest-source.env
ExecStart=@WORKDIR@/scripts/refresh_signalops_pgbackrest_credentials.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/etc/signalops
