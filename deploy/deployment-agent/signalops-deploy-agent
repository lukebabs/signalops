#!/usr/bin/env bash
set -euo pipefail

# Installed root-owned by provision_signalops_deployment_agent.sh.  This is an
# allowlisted control surface, not a general deployment shell.
root_dir=/usr/local/lib/signalops-deployment-agent
repository_dir=@REPOSITORY_DIR@
action="${1:-}"
actor="${SUDO_USER:-unknown}"

[[ "$#" -eq 1 ]] || {
  printf 'Usage: signalops-deploy-agent <action>\n' >&2
  exit 2
}

audit() {
  logger -p authpriv.notice -t signalops-deploy-agent \
    "actor=${actor} action=${action} result=$1"
}

run() {
  "$@"
  audit success
}

case "$action" in
  render-cutover-env)
    run "$root_dir/render_marketops_cutover_env.sh"
    ;;
  scheduler-preflight)
    run systemctl start signalops-marketops-boundary-schedule@preflight.service
    ;;
  scheduler-intraday-run)
    run systemctl start signalops-marketops-boundary-schedule@marketops-intraday.service
    ;;
  scheduler-intraday-enable)
    run systemctl enable --now signalops-marketops-boundary-intraday.timer
    ;;
  scheduler-intraday-disable)
    run systemctl disable --now signalops-marketops-boundary-intraday.timer
    ;;
  operations-monitor-install)
    run "$repository_dir/scripts/install_marketops_operations_monitor.sh"
    ;;
  operations-monitor-run)
    run systemctl start signalops-marketops-operations-monitor.service
    ;;
  operations-monitor-enable)
    run systemctl enable --now signalops-marketops-operations-monitor.timer
    ;;
  operations-monitor-disable)
    run systemctl disable --now signalops-marketops-operations-monitor.timer
    ;;
  watch-limits-stage)
    run "$repository_dir/scripts/provision_signalops_systemd_watch_limits.sh"
    ;;
  marketops-recovery-resume)
    systemctl enable --now signalops-marketops-boundary-daily-postclose.timer signalops-marketops-boundary-postclose-recovery.timer signalops-marketops-boundary-sri-refresh.timer signalops-marketops-boundary-sri-holdings-refresh.timer
    systemctl start signalops-marketops-boundary-schedule@marketops-daily-postclose.service
    audit success
    ;;
  marketops-postclose-status-reconcile)
    run systemctl start signalops-marketops-boundary-schedule@marketops-postclose-recovery.service
    ;;
  marketops-sri-refresh-run)
    run systemctl start signalops-marketops-boundary-schedule@marketops-sri-refresh.service
    ;;
  marketops-warm-eod-enable)
    run "$repository_dir/scripts/install_marketops_boundary_scheduler.sh" "$repository_dir/.env" "adminalien" --enable-warm-eod
    ;;
  marketops-global-market-state-migration)
    run "$repository_dir/scripts/apply_marketops_migration_000125.sh" "$repository_dir/.env"
    ;;
  subscriber-pilot-ui-smoke)
    [[ "$actor" =~ ^[a-z_][a-z0-9_-]*$ && "$actor" != "unknown" ]] || {
      printf "%s\n" "subscriber_pilot_ui_smoke_operator_invalid" >&2
      exit 2
    }
    run runuser -u "$actor" -- env "HOME=/home/$actor" "PLAYWRIGHT_BROWSERS_PATH=/home/$actor/.cache/ms-playwright" \
      "$repository_dir/scripts/run_subscriber_pilot_ui_smoke.sh"
    ;;
  marketops-gateway-deploy)
    "$repository_dir/scripts/deploy_marketops_read_cutover.sh" "$repository_dir/.env"
    run runuser -u "$actor" -- env "HOME=/home/$actor" "PLAYWRIGHT_BROWSERS_PATH=/home/$actor/.cache/ms-playwright" \
      "$repository_dir/scripts/run_subscriber_pilot_ui_smoke.sh"
    ;;
  marketops-writer-cutover)
    systemctl stop signalops-marketops-boundary-schedule@marketops-daily-postclose.service signalops-marketops-boundary-schedule@marketops-postclose-recovery.service || true
    run "$repository_dir/scripts/deploy_marketops_writer_cutover.sh" --dedicated-authoritative "$repository_dir/.env"
    ;;
  backup-run)
    run systemctl start signalops-marketops-pgbackrest.service
    ;;
  restore-rehearsal-run)
    run "$repository_dir/scripts/marketops_pgbackrest_restore_rehearsal.sh"
    ;;
  scheduler-status)
    systemctl status \
      signalops-marketops-boundary-schedule@preflight.service \
      signalops-marketops-boundary-schedule@marketops-intraday.service \
      signalops-marketops-boundary-intraday.timer \
      --no-pager -l
    audit success
    ;;
  *)
    printf 'Unsupported deployment-agent action: %s\n' "$action" >&2
    audit rejected
    exit 2
    ;;
esac
